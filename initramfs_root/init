#!/bin/sh
#
# Minimal init for the Ouroboros ramdisk environment.
# For now this simply performs basic setup and invokes the reimage script
# in a non-destructive dry mode.
#

set -eu

mount_fs() {
    mount -t proc proc /proc || true
    mount -t sysfs sys /sys || true
    mount -t devtmpfs devtmpfs /dev || true
}

main() {
    echo "[ouroboros][init] starting minimal initramfs environment"

    mount_fs

    # In a future iteration we may pivot_root into a dedicated RAM root and
    # start a tiny userland. For now, we assume scripts are available at /scripts.
    if [ -x /scripts/reimage_usb_from_ram.sh ]; then
        /scripts/reimage_usb_from_ram.sh || {
            echo "[ouroboros][init] reimage script failed; dropping to emergency shell"
            exec sh
        }
    else
        echo "[ouroboros][init] /scripts/reimage_usb_from_ram.sh not found or not executable"
        echo "[ouroboros][init] dropping to emergency shell"
        exec sh
    fi

    echo "[ouroboros][init] reimage script completed (dry mode); syncing and rebooting"
    sync || true
    reboot -f

    # Fallback in case reboot fails
    exec sh
}

main "$@"
