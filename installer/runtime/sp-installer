#!/bin/sh
# Screaming Penguin installer orchestrator (Phase 5).
# Implements the full installer state machine.

set -eu

# shellcheck disable=SC1091
. "$(dirname "$0")/lib/logging.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/lib/config_validation.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/lib/safety_checks.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/sp-disk-plan.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/sp-disk-apply.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/sp-rootfs-apply.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/sp-chroot-setup.sh"
# shellcheck disable=SC1091
. "$(dirname "$0")/sp-audio.sh"

SP_STATE_BOOT_INIT="BOOT_INIT"
SP_STATE_LOAD_CONFIG="LOAD_CONFIG"
SP_STATE_PLAN_INSTALL="PLAN_INSTALL"
SP_STATE_CONFIRM_INSTALL="CONFIRM_INSTALL"
SP_STATE_EXECUTE_INSTALL="EXECUTE_INSTALL"
SP_STATE_FINISH="FINISH"

: "${SP_TARGET_MNT:=/mnt/target}"
: "${SP_CONFIG_PATH:=/config/installer-config.yml}"

SP_INSTALL_STATUS="ok"

sp_state_boot_init() {
    # Prefer writing logs to /config/logs if available.
    if [ -d "/config" ]; then
        ts="$(date -u +"%Y%m%dT%H%M%SZ" 2>/dev/null || echo "notime")"
        SP_LOG_FILE="/config/logs/installer-${ts}.log"
    fi

    export SP_LOG_FILE

    log_info "Screaming Penguin installer starting (Phase 5)."
    log_info "Using config path: $SP_CONFIG_PATH"
    log_info "Log file: $SP_LOG_FILE"

    sp_audio_ready || log_warn "Audio ready hook failed (non-fatal)."

    # Optional: boot disk hint can be set externally (e.g., by initramfs).
    if [ -n "${SP_BOOT_DISK:-}" ]; then
        log_info "Boot disk hint: $SP_BOOT_DISK"
    else
        log_warn "No boot disk hint (SP_BOOT_DISK) provided."
    fi

    return 0
}

sp_state_load_config() {
    log_info "State: LOAD_CONFIG"

    if ! sp_config_load "$SP_CONFIG_PATH"; then
        log_error "Configuration load/validation failed."
        SP_INSTALL_STATUS="error"
        return 1
    fi

    return 0
}

sp_state_plan_install() {
    log_info "State: PLAN_INSTALL"

    if ! sp_safety_check_all; then
        log_error "Safety checks failed; aborting install."
        SP_INSTALL_STATUS="error"
        return 1
    fi

    if ! sp_disk_plan; then
        log_error "Disk planning failed."
        SP_INSTALL_STATUS="error"
        return 1
    fi

    return 0
}

sp_state_confirm_install() {
    log_info "State: CONFIRM_INSTALL"

    if [ "${SP_CFG_REQUIRE_ERASE_WORD:-true}" = "true" ]; then
        prompt="Type ERASE to confirm full wipe of ${SP_TARGET_DISK_DEV}: "
        # Use console for interaction; fall back to stdout if console is unavailable.
        if [ -w /dev/console ]; then
            printf "%s" "$prompt" >/dev/console
            read_erase_word="$(dd bs=1 count=64 2>/dev/null </dev/console | tr -d '\r\n')"
        else
            printf "%s" "$prompt"
            # shellcheck disable=SC2162
            read read_erase_word
        fi

        if [ "$read_erase_word" != "ERASE" ]; then
            log_error "Erase confirmation mismatch; expected 'ERASE', got '$read_erase_word'."
            SP_INSTALL_STATUS="error"
            return 1
        fi

        log_info "Erase confirmation accepted."
    else
        log_info "Erase confirmation disabled by configuration."
    fi

    return 0
}

sp_state_execute_install() {
    log_info "State: EXECUTE_INSTALL"

    if ! sp_disk_apply; then
        log_error "Disk apply failed."
        SP_INSTALL_STATUS="error"
        return 1
    fi

    if ! sp_rootfs_apply; then
        log_error "Rootfs apply failed."
        SP_INSTALL_STATUS="error"
        return 1
    fi

    if ! sp_chroot_setup; then
        log_error "Chroot setup failed."
        SP_INSTALL_STATUS="error"
        return 1
    fi

    return 0
}

sp_state_finish() {
    log_info "State: FINISH"

    if [ "$SP_INSTALL_STATUS" = "ok" ]; then
        log_info "Installation completed successfully."
        sp_audio_complete || log_warn "Audio completion hook failed (non-fatal)."
        return 0
    fi

    log_error "Installation failed; see log for details."
    sp_audio_complete || log_warn "Audio completion hook failed (non-fatal)."
    return 1
}

sp_run() {
    state="$SP_STATE_BOOT_INIT"

    while :; do
        case "$state" in
            "$SP_STATE_BOOT_INIT")
                if sp_state_boot_init; then
                    state="$SP_STATE_LOAD_CONFIG"
                else
                    state="$SP_STATE_FINISH"
                    SP_INSTALL_STATUS="error"
                fi
                ;;
            "$SP_STATE_LOAD_CONFIG")
                if sp_state_load_config; then
                    state="$SP_STATE_PLAN_INSTALL"
                else
                    state="$SP_STATE_FINISH"
                fi
                ;;
            "$SP_STATE_PLAN_INSTALL")
                if sp_state_plan_install; then
                    state="$SP_STATE_CONFIRM_INSTALL"
                else
                    state="$SP_STATE_FINISH"
                fi
                ;;
            "$SP_STATE_CONFIRM_INSTALL")
                if sp_state_confirm_install; then
                    state="$SP_STATE_EXECUTE_INSTALL"
                else
                    state="$SP_STATE_FINISH"
                fi
                ;;
            "$SP_STATE_EXECUTE_INSTALL")
                if sp_state_execute_install; then
                    state="$SP_STATE_FINISH"
                else
                    state="$SP_STATE_FINISH"
                fi
                ;;
            "$SP_STATE_FINISH")
                sp_state_finish
                break
                ;;
            *)
                log_warn "Unknown state encountered: $state"
                SP_INSTALL_STATUS="error"
                state="$SP_STATE_FINISH"
                ;;
        esac
    done

    log_info "Screaming Penguin installer exiting with status: $SP_INSTALL_STATUS"
    if [ "$SP_INSTALL_STATUS" = "ok" ]; then
        exit 0
    fi
    exit 1
}

sp_run "$@"
