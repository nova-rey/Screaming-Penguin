#!/bin/sh

# Screaming Penguin initramfs entrypoint

set -eu

# Basic PATH for BusyBox
export PATH=/sbin:/bin:/usr/sbin:/usr/bin

# Source logging helpers
if [ -f /lib/log.sh ]; then
    # Some initramfs layouts may place helpers under /lib
    . /lib/log.sh
elif [ -f /initramfs/lib/log.sh ]; then
    # Fallback: explicit path when running from unpacked tree
    . /initramfs/lib/log.sh
else
    # Minimal inline fallback if log.sh is missing
    SP_LOG_DIR="/run/sp/log"
    SP_LOG_FILE="${SP_LOG_DIR}/init.log"
    mkdir -p "${SP_LOG_DIR}" 2>/dev/null || true
    sp_log_init() { mkdir -p "${SP_LOG_DIR}" 2>/dev/null || true; }
    sp_log_info() { echo "INFO [SP-BOOT] $*" >&2; }
    sp_log_warn() { echo "WARN [SP-BOOT] $*" >&2; }
    sp_log_error() { echo "ERROR [SP-BOOT] $*" >&2; }
    sp_die() {
        echo "ERROR [SP-BOOT] $*" >&2
        exit 1
    }
fi

sp_log_init

sp_log_info "[SP-BOOT]" "Screaming Penguin initramfs starting"
sp_log_info "[SP-BOOT]" "Kernel cmdline: $(cat /proc/cmdline 2>/dev/null || echo '<unavailable>')"

# Existing minimal behavior: we should still reach the installer entry point
# and print the [SP-INSTALLER] tag used by CI.
sp_log_info "[SP-INSTALLER]" "init reached; handing off to installer logic (stub)"

# TODO: later phases will call into real installer scripts here.
# For now, keep behavior equivalent to the stripped-down init:
# - Print a message.
# - Exit cleanly so CI knows the boot path is working.

sp_log_info "[SP-BOOT]" "Screaming Penguin initramfs exiting cleanly"
exit 0
