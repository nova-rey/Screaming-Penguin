#!/bin/sh
set -eu

PATH=/bin:/sbin
export PATH

echo "[init] Mounting virtual filesystems."
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev

REIMAGE_SCRIPT="/ouroboros/scripts/reimage_usb_from_ram.sh"
USB_POLICY_SCRIPT="/ouroboros/scripts/assert_usb_only_environment.sh"

if [ -x "$USB_POLICY_SCRIPT" ]; then
  if ! "$USB_POLICY_SCRIPT"; then
    echo "[init] USB-only policy assertion failed; dropping to shell." >&2
    exec sh
  fi
else
  echo "[init] USB-only policy helper missing at $USB_POLICY_SCRIPT; dropping to shell." >&2
  exec sh
fi

if [ -x "$REIMAGE_SCRIPT" ]; then
  if ! "$REIMAGE_SCRIPT"; then
    echo "[init] Reimage script failed; dropping to shell." >&2
    exec sh
  fi
echo "[init] Reimage script completed successfully."
else
  echo "[init] Reimage script not found at $REIMAGE_SCRIPT; dropping to shell." >&2
  exec sh
fi

# Continue with shell so the initramfs can stay interactive.
exec sh
